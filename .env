BIND_HOST=0.0.0.0
# Routable target/advertised addresses. Use localhost for one PC; set each host
# to the node machine's LAN IP/DNS in a multi-PC deployment.
HOST_NODE1=localhost
HOST_NODE2=localhost
HOST_NODE3=localhost
HOST_NODE4=localhost
# Optional override only when Pyro must bind a different local interface.
# RMI_BIND_HOST_NODE1=192.168.1.10
# RMI_BIND_HOST_NODE2=192.168.1.11
# RMI_BIND_HOST_NODE3=192.168.1.12
# RMI_BIND_HOST_NODE4=192.168.1.13
LAUNCHER_HOST=0.0.0.0
LAUNCHER_PORT=8000
RPC_BASE_PORT=5000
RMI_BASE_PORT=6000
API_BASE_PORT=8000
CLI_HTTP_TIMEOUT=3
